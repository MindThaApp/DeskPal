<Application x:Class="DeskPal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Theme-aware looks: ThemeResource inside a Style resolves against the element's own theme, not the app's. -->
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="CardFillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SubtleFillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
