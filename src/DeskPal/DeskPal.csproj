<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeskPal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\deskpal.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableXamlRootNamespaceCheck>true</DisableXamlRootNamespaceCheck>
    <!-- No global using Sentry, no native crash handler (it would bypass the consent gate and the redaction), no build paths in the assembly. -->
    <SentryImplicitUsings>false</SentryImplicitUsings>
    <SentryNative>false</SentryNative>
    <SentryDisableSourceGenerator>true</SentryDisableSourceGenerator>
  </PropertyGroup>
  <!--
    Packaging switch. Default: the portable, unpackaged self-contained build. -p:DeskPalStore=true builds the Store MSIX
    from Package.appxmanifest (tools/Build-StorePackage.ps1).
  -->
  <PropertyGroup Condition="'$(DeskPalStore)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DeskPalStore)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(DeskPalStore)' == 'true'">
    <Content Include="Assets\Store\*.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(DeskPalStore)' != 'true'">
    <AppxManifest Remove="Package.appxmanifest" />
    <None Remove="Package.appxmanifest" />
  </ItemGroup>
  <Target Name="DpDropSentryAttributes" AfterTargets="WriteSentryAttributes" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)$(SentryAttributesFile)" />
    </ItemGroup>
  </Target>
  <!-- The SkiaSharp native symbols are ~85 MB and not needed at run time. -->
  <Target Name="DpDropSkiaSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
  </Target>
  <!-- The Windows App SDK pulls in its on-device ML runtime (onnxruntime.dll, DirectML.dll, ~40 MB); Desk Pal never uses it. -->
  <ItemGroup Condition="'$(DeskPalStore)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(DpBetaTag)' != ''">
    <AssemblyMetadata Include="DpBetaTag" Value="$(DpBetaTag)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <Content Include="Assets\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Models\*.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Shaders\*.cso" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Tray\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\deskpal.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeskPal.Core\DeskPal.Core.csproj" />
  </ItemGroup>
</Project>

