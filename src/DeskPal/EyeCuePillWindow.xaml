<Window x:Class="DeskPal.EyeCuePillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="16,0" PointerPressed="OnPressed">
        <StackPanel VerticalAlignment="Center" Spacing="6">
            <TextBlock x:Name="LabelText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="4" />
        </StackPanel>
    </Grid>
</Window>
