<Page x:Class="DeskPal.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid x:Name="Root" Padding="28,20,28,28" ColumnSpacing="28" Background="Transparent"
              PointerMoved="OnPointerMoved" PointerExited="OnPointerExited">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8" VerticalAlignment="Top">
                <Grid>
                    <Grid x:Name="Stage" Width="320" Height="320" Background="Transparent"
                          x:Uid="Home_Stage">
                        <Image x:Name="Avatar" />
                    </Grid>
                    <Image x:Name="SproutImage" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,-40,0" IsHitTestVisible="False" />
                    <!-- Wider than the stage so the 3D Sprout stands beside Bloop; Bloop stays centred at x = 160. -->
                    <SwapChainPanel x:Name="LivePanel" Width="400" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="0,0,-80,0" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Border x:Name="SproutHit" Width="80" Height="120" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="300,140,-80,0" Background="Transparent" Visibility="Collapsed"
                            PointerPressed="OnSproutPressed" x:Uid="Home_SproutHit" />
                </Grid>
                <Button x:Name="SoundButton" HorizontalAlignment="Left" Click="OnToggleSound" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="SoundIcon" FontSize="14" />
                        <TextBlock x:Name="SoundText" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel x:Name="InfoColumn" Grid.Column="1" Spacing="16" MaxWidth="520" Padding="40,0,0,0">
                <TextBlock x:Name="GreetingText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Border x:Name="RecapCard" Visibility="Collapsed" Padding="16" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Home_RecapTitle" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Home_RecapIntro" TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock x:Name="RecapLines" TextWrapping="Wrap" />
                        <Button x:Uid="Home_RecapDismiss" Click="OnRecapDismiss" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Home_NextUpHeader" FontWeight="SemiBold" />
                    <TextBlock x:Name="NextText" TextWrapping="Wrap" />
                    <TextBlock x:Name="HoldsText" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Home_TodayHeader" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountsText" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Home_StreakHeader" FontWeight="SemiBold" />
                    <TextBlock x:Name="StreakOverall" TextWrapping="Wrap" />
                    <TextBlock x:Name="StreakGoals" TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock x:Name="StreakNote" TextWrapping="Wrap" Opacity="0.8" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="LastWeekLink" x:Uid="Home_LastWeekLink" Click="OnLastWeek" Padding="0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Home_QuickActionsHeader" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Home_StretchNow" Style="{StaticResource AccentButtonStyle}" Click="OnStretchNow" />
                        <Button x:Uid="Home_EyeNow" Click="OnEyeNow" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PauseButton" Click="OnPause" />
                        <Button x:Uid="Home_OpenSettings" Click="OnSettings" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
