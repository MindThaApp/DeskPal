<Window x:Class="DeskPal.NudgeCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DeskPal">
    <Window.SystemBackdrop>
        <local:SoftCardBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="14,10,8,10" RowSpacing="4" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="8" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button x:Name="MoreButton" Grid.Column="1" Width="28" Height="24" Padding="0" Background="Transparent"
                    BorderThickness="0" x:Uid="Nudge_More">
                <FontIcon Glyph="&#xE712;" FontSize="12" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="SkipItem" x:Uid="Nudge_Skip" Click="OnSkip" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <TextBlock x:Name="HintText" Grid.Row="1" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,6,0" />
        <!-- Stretch with Bloop: the camera button, and while it runs the progress ring, the hint and a way to stop. -->
        <StackPanel x:Name="StretchArea" Grid.Row="2" Spacing="6" Margin="0,2,6,0" Visibility="Collapsed">
            <Button x:Name="StretchButton" FontSize="12" Padding="10,3" MinHeight="26" HorizontalAlignment="Left" Click="OnStretchWithBloop">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE722;" FontSize="12" />
                    <TextBlock x:Name="StretchButtonText" FontSize="12" />
                </StackPanel>
            </Button>
            <Grid x:Name="PosePanel" ColumnSpacing="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing x:Name="PoseRing" Width="36" Height="36" IsIndeterminate="False" Minimum="0" Maximum="100"
                              Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                              VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="PoseHint" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="PoseSides" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="PoseCameraOn" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="StopCameraButton" Grid.Column="2" FontSize="12" Padding="10,3" MinHeight="26" VerticalAlignment="Center"
                        Click="OnStopCamera" />
            </Grid>
            <TextBlock x:Name="PoseNotice" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
            <HyperlinkButton x:Name="PoseSettingsLink" FontSize="12" Padding="0" Visibility="Collapsed" Click="OnCameraSettings" />
        </StackPanel>
        <Grid x:Name="ButtonsRow" Grid.Row="3" Margin="0,0,6,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="CountdownPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressRing x:Name="Ring" Width="16" Height="16" IsIndeterminate="False" Minimum="0" Maximum="100" />
                <TextBlock x:Name="CountdownText" VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
                <TextBlock x:Name="BonusHint" x:Uid="Nudge_BonusHintText" VerticalAlignment="Center" FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxWidth="150"
                           />
            </StackPanel>
            <Button x:Name="DoneButton" Grid.Column="1" x:Uid="Nudge_Done" FontSize="12" Padding="12,3" MinHeight="26"
                    Style="{StaticResource AccentButtonStyle}" Click="OnDone" />
            <Button x:Name="SnoozeButton" Grid.Column="2" x:Uid="Nudge_Snooze" FontSize="12" Padding="10,3" MinHeight="26"
                    Click="OnSnooze" />
        </Grid>
        <!-- How long until the card hides by itself: a thin line along the bottom edge that shrinks to the left. -->
        <Rectangle x:Name="HideLine" Grid.Row="4" Height="2" Margin="0,4,6,0" HorizontalAlignment="Stretch"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.6" IsHitTestVisible="False"
                   AutomationProperties.AccessibilityView="Raw">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="HideLineScale" ScaleX="1" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</Window>
