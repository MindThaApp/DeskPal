<Window x:Class="DeskPal.NudgeCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="16,14,16,14" RowSpacing="10">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="24" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="Avatar" Width="72" Height="72" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InstructionText" FontSize="12" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                           Opacity="0.8" Visibility="Collapsed" />
                <StackPanel x:Name="CountdownPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <ProgressRing x:Name="Ring" Width="22" Height="22" IsIndeterminate="False" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="CountdownText" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="DoneButton" Content="Done" Style="{StaticResource AccentButtonStyle}" Click="OnDone" />
            <Button x:Name="SnoozeButton" Content="Snooze 5 min" Click="OnSnooze" />
            <Button x:Name="SkipButton" Content="Skip" Click="OnSkip" />
        </StackPanel>
    </Grid>
</Window>
