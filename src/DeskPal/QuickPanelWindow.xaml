<Window x:Class="DeskPal.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="16" RowSpacing="10" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="72" Height="72" Background="Transparent" PointerPressed="OnAvatarPressed"
                  AutomationProperties.Name="Bloop" AutomationProperties.AccessibilityView="Raw">
                <Image x:Name="Avatar" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="Squish" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="StretchStat" Grid.Column="0" HorizontalAlignment="Center" Spacing="2" />
            <StackPanel x:Name="EyeStat" Grid.Column="1" HorizontalAlignment="Center" Spacing="2" />
            <StackPanel x:Name="WalkStat" Grid.Column="2" HorizontalAlignment="Center" Spacing="2" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StretchButton" Grid.Column="0" Content="Stretch now" HorizontalAlignment="Stretch" FontSize="12"
                    Padding="4,6" Click="OnStretch" AutomationProperties.Name="Stretch now" />
            <Button x:Name="EyeButton" Grid.Column="1" Content="Eye break" HorizontalAlignment="Stretch" FontSize="12"
                    Padding="4,6" Click="OnEye" AutomationProperties.Name="Eye break" />
            <Button x:Name="PauseButton" Grid.Column="2" Content="Pause 30 min" HorizontalAlignment="Stretch" FontSize="12"
                    Padding="4,6" Click="OnPause" AutomationProperties.Name="Pause 30 minutes" />
        </Grid>

        <HyperlinkButton x:Name="OpenLink" Grid.Row="3" Content="Open Desk Pal ›" Padding="0,4" Click="OnOpen"
                         AutomationProperties.Name="Open Desk Pal" />
    </Grid>
</Window>
