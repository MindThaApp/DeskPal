<Window x:Class="DeskPal.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="16" RowSpacing="10" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SoundButton" Grid.Column="1" VerticalAlignment="Top" Width="32" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0" Click="OnSound" Visibility="Collapsed">
                <FontIcon x:Name="SoundIcon" FontSize="14" Glyph="&#xE767;" />
            </Button>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="StretchStat" Grid.Column="0" HorizontalAlignment="Center" Spacing="2" />
            <StackPanel x:Name="EyeStat" Grid.Column="1" HorizontalAlignment="Center" Spacing="2" />
            <StackPanel x:Name="WalkStat" Grid.Column="2" HorizontalAlignment="Center" Spacing="2" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StretchButton" Grid.Column="0" x:Uid="Quick_StretchButton" HorizontalAlignment="Stretch" FontSize="12"
                    Padding="4,6" Click="OnStretch" />
            <Button x:Name="EyeButton" Grid.Column="1" x:Uid="Quick_EyeButton" HorizontalAlignment="Stretch" FontSize="12"
                    Padding="4,6" Click="OnEye" />
            <Button x:Name="PauseButton" Grid.Column="2" HorizontalAlignment="Stretch" FontSize="12"
                    Padding="4,6" Click="OnPause" />
        </Grid>

        <HyperlinkButton x:Name="OpenLink" Grid.Row="3" x:Uid="Quick_OpenLink" Padding="0,4" Click="OnOpen" />
    </Grid>
</Window>
