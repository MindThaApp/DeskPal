<Window x:Class="DeskPal.TodayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="18,14,18,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Today" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="GearButton" HorizontalAlignment="Right" Padding="8,4" Click="OnSettings"
                    AutomationProperties.Name="Open settings" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock x:Name="NextText" TextWrapping="Wrap" />
            <TextBlock x:Name="StretchText" />
            <TextBlock x:Name="EyesText" />
            <TextBlock x:Name="HoldsText" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>
        <Button Grid.Row="2" x:Name="PauseButton" HorizontalAlignment="Stretch" Click="OnPause" />
    </Grid>
</Window>
