<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the pose model path (image in memory, model, decoding) without the app or a camera. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\DeskPal\Pose\PoseModel.cs" Link="Pose\PoseModel.cs" />
    <Compile Include="..\..\src\DeskPal\Pose\PoseImage.cs" Link="Pose\PoseImage.cs" />
    <Compile Include="..\..\src\DeskPal\Pose\PoseWatchdog.cs" Link="Pose\PoseWatchdog.cs" />
    <Content Include="..\..\src\DeskPal\Assets\Models\movenet-singlepose-lightning.onnx" Link="Assets\Models\movenet-singlepose-lightning.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestData\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskPal.Core\DeskPal.Core.csproj" />
  </ItemGroup>

</Project>
